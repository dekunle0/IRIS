{
  "name": "iris-sdk",
  "version": "1.0.0",
  "description": "SDK for the IRIS Clinical Diagnostics Platform",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
