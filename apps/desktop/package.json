{
  "name": "IRIS",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "main": "dist-electron/index.js",
  "productName": "IRIS",
  "author": "KytoLabx Ltd",
  "description": "Offline Clinical Workstation",
  "scripts": {
    "start": "electron .",
    "dev": "vite",
    "build:ai": "cd ../.. && cd packages/ai && \".venv\\Scripts\\python.exe\" -m PyInstaller iris-ai-service.spec --distpath ../../apps/desktop/ai-service-dist --workpath ../../.tmp/pyinstaller --noconfirm",
    "build:ui": "vite build",
    "build:main": "tsup src/main/index.ts src/main/preload.ts src/main/db.ts --outDir dist-electron --format cjs --external electron,better-sqlite3-multiple-ciphers,bcryptjs,otplib",
    "build": "pnpm build:ui && pnpm build:main",
    "pack:win": "pnpm build:ai && pnpm build && electron-builder --win -c electron-builder.yml",
    "pack:linux": "pnpm build && electron-builder --linux",
    "postinstall": "node scripts/rebuild-native.js"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@pdf-lib/standard-fonts": "^1.0.0",
    "@pdf-lib/upng": "^1.0.1",
    "@phc/format": "^1.0.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3-multiple-ciphers": "^9.1.1",
    "bindings": "^1.5.0",
    "chownr": "^3.0.0",
    "dijkstrajs": "^1.0.3",
    "encode-utf8": "^2.0.0",
    "env-paths": "^4.0.0",
    "file-uri-to-path": "^2.0.0",
    "fs-minipass": "^3.0.3",
    "minipass": "^7.1.3",
    "mkdirp": "^3.0.1",
    "node-addon-api": "^8.9.2",
    "node-gyp-build": "^4.8.4",
    "pako": "^3.0.2",
    "pdf-lib": "^1.17.1",
    "pngjs": "^7.0.0",
    "prebuild-install": "^7.1.3",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-signature-canvas": "^1.0.6",
    "recharts": "^3.10.1",
    "tar": "^7.5.22",
    "thirty-two": "^1.0.2",
    "tslib": "^2.8.1",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/forms": "^0.5.11",
    "@types/bcryptjs": "^3.0.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/react-signature-canvas": "^1.0.5",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.5.5",
    "electron": "^41.10.6",
    "electron-builder": "^24.13.3",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tsup": "^8.2.4",
    "typescript": "^5.6.2",
    "vite": "^5.4.1"
  }
}